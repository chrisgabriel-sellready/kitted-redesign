<div class="kg">
<section class="section">
<div class="wrap">
<div class="section-head"><h2 class="h-section">{{ section.settings.t1 }}</h2><p class="lede muted">{{ section.settings.t2 }}</p></div>
<div class="compare">{%- for block in section.blocks -%}{%- case block.type -%}{%- when "c1a" -%}<div {{ block.shopify_attributes }} class="compare__col"><p class="eyebrow muted">{{ block.settings.t1 }}</p><h3>{{ block.settings.t2 }}</h3><ul><li><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"></path></svg><span>{{ block.settings.t3 }}</span></li><li><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"></path></svg><span>{{ block.settings.t4 }}</span></li><li><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"></path></svg><span>{{ block.settings.t5 }}</span></li><li><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"></path></svg><span>{{ block.settings.t6 }}</span></li></ul></div>{%- when "c1b" -%}<div {{ block.shopify_attributes }} class="compare__col"><p class="eyebrow" style="color:var(--gold)">{{ block.settings.t1 }}</p><h3>{{ block.settings.t2 }}</h3><ul><li><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5"></path></svg><span>{{ block.settings.t3 }}</span></li><li><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5"></path></svg><span>{{ block.settings.t4 }}</span></li><li><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5"></path></svg><span>{{ block.settings.t5 }}</span></li><li><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5"></path></svg><span>{{ block.settings.t6 }}</span></li></ul></div>{%- endcase -%}{%- endfor -%}</div>
</div>
</section>
</div>


<div class="kg">
<section class="section">
<div class="wrap">
<h2 class="h-section" style="margin-bottom:clamp(20px,3vw,32px)">{{ section.settings.t1 }}</h2>
<div class="faq-panel"><div class="faq-list">{%- for block in section.blocks -%}{%- case block.type -%}{%- when "c1a" -%}<details {{ block.shopify_attributes }} class="acc"><summary>{{ block.settings.t1 }}<span aria-hidden="true" class="pm"></span></summary><div class="acc__body"><p>{{ block.settings.t2 }}</p></div></details>{%- endcase -%}{%- endfor -%}</div></div>
</div>
</section>
</div>

{% schema %}
{
 "name": "KITTED: Frequently asked",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "text",
   "id": "t1",
   "label": "Heading: Frequently asked",
   "default": "Frequently asked"
  }
 ],
 "blocks": [
  {
   "type": "c1a",
   "name": "Question",
   "settings": [
    {
     "type": "text",
     "id": "t1",
     "label": "Question: How do I get access?"
    },
    {
     "type": "textarea",
     "id": "t2",
     "label": "Text: It's 100% digital. Right…"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "KITTED: Frequently asked"
  }
 ]
}
{% endschema %}

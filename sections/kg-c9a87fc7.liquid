<div class="kg">
<section class="section">
<div class="wrap split split--media-first">
<div class="split__media" style=""><div style="max-width:380px;margin-inline:auto"><figure class="vcard" style="margin:0">
<div class="vcard__frame">
<video autoplay muted loop playsinline poster="{%- if section.settings.i3 != blank -%}{{ section.settings.i3 | image_url: width: 1200 }}{%- elsif section.settings.t4 != blank -%}{{ section.settings.t4 | asset_url }}{%- elsif section.settings.v1 != blank -%}{{ section.settings.v1.preview_image | image_url: width: 1200 }}{%- endif -%}" preload="metadata" src="{%- if section.settings.v1 != blank -%}{{ section.settings.v1.sources | where: "mime_type", "video/mp4" | map: "url" | first }}{%- else -%}{{ section.settings.u2 }}{%- endif -%}"></video>
</div>
</figure></div></div>
<div class="split__text">
<p class="eyebrow">{{ section.settings.t6 }}</p>
<h2 class="h-section">{{ section.settings.t7 }}</h2>
<p class="lede">{{ section.settings.t8 }}</p>
<div class="btn-row"><a class="btn" href="{{ section.settings.kg_shop_url | default: '#buy' }}">{{ section.settings.t9 }}<svg aria-hidden="true" class="arrow" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></div>
</div>
</div>
</section>
</div>

{% schema %}
{
 "name": "KITTED: Baseball's first-",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "video",
   "id": "v1",
   "label": "Video (Shopify file)"
  },
  {
   "type": "url",
   "id": "u2",
   "label": "Video URL (used when no video is picked)"
  },
  {
   "type": "image_picker",
   "id": "i3",
   "label": "Video cover image"
  },
  {
   "type": "text",
   "id": "t4",
   "label": "Built-in cover image",
   "default": "kg-poster-what-is-spingrip.webp"
  },
  {
   "type": "text",
   "id": "t5",
   "label": "Text: Tap for sound"
  },
  {
   "type": "text",
   "id": "t6",
   "label": "Eyebrow: What is the SpinGrip thr..."
  },
  {
   "type": "text",
   "id": "t7",
   "label": "Heading: Baseball's first-ever th..."
  },
  {
   "type": "textarea",
   "id": "t8",
   "label": "Text: With its patent-pending ..."
  },
  {
   "type": "text",
   "id": "t9",
   "label": "Link text: Shop SpinGrip"
  },
  {
   "type": "url",
   "id": "kg_shop_url",
   "label": "Shop button link",
   "info": "Leave empty to scroll to the buy box on this page."
  }
 ],
 "presets": [
  {
   "name": "KITTED: Baseball's first-"
  }
 ]
}
{% endschema %}

{%- comment -%}
  Customer reviews, matching the live kittedgear.com product pages: header with
  average + count, then a swipeable row of review cards. Featured review blocks
  (editable) come first, followed by the newest Judge.me reviews for the product,
  loaded from Judge.me's public widget endpoint.
{%- endcomment -%}
{%- liquid
  assign review_product = section.settings.product | default: product
  assign rating = review_product.metafields.reviews.rating.value.rating | round: 1
  assign rating_count = review_product.metafields.reviews.rating_count.value | default: 0
  assign featured = section.blocks | where: 'type', 'featured'
-%}
{%- capture star -%}<svg viewBox="0 0 24 24"><path d="M11.5 2.3a.53.53 0 0 1 .95 0l2.31 4.68a2.12 2.12 0 0 0 1.6 1.16l5.16.76a.53.53 0 0 1 .3.9l-3.74 3.64a2.12 2.12 0 0 0-.61 1.87l.88 5.14a.53.53 0 0 1-.77.56l-4.62-2.43a2.12 2.12 0 0 0-1.97 0L6.4 21.01a.53.53 0 0 1-.77-.56l.88-5.14a2.12 2.12 0 0 0-.61-1.87L2.17 9.8a.53.53 0 0 1 .3-.9l5.16-.76a2.12 2.12 0 0 0 1.6-1.16z"/></svg>{%- endcapture -%}
<div class="kg">
<section class="lrev" id="reviews" style="scroll-margin-top:calc(var(--header-h, 80px) + 12px)"
  data-kg-reviews
  data-shop="{{ shop.permanent_domain }}"
  data-product-id="{{ review_product.id }}"
  data-limit="{{ section.settings.limit }}">
  <div class="lrev__wrap">
    <div class="lrev__head">
      <h2 class="lrev__title">{{ section.settings.heading | escape }}</h2>
      <div class="lrev__summary" data-kg-rating{% if rating_count == 0 %} hidden{% endif %}>
        <span class="lrev__stars" aria-hidden="true">{%- for i in (1..5) -%}{{ star }}{%- endfor -%}</span>
        <span><b data-kg-avg>{{ rating }}</b> out of 5 · <span data-kg-count>{{ rating_count }}</span> reviews</span>
      </div>
    </div>
    <div class="lrev__viewport" data-kg-reviews-viewport>
      <div class="lrev__track" data-kg-reviews-track>
        {%- for b in featured -%}
          <div class="lrev__slide" {{ b.shopify_attributes }}>
            <article class="lrev__card">
              <div class="lrev__top">
                <div class="lrev__meta"><span class="lrev__stars" aria-label="{{ b.settings.rating }} out of 5 stars">{%- for i in (1..5) -%}{%- if i <= b.settings.rating -%}{{ star }}{%- else -%}{{ star | replace: '<svg ', '<svg class="is-empty" ' }}{%- endif -%}{%- endfor -%}</span></div>
                {%- if b.settings.date != blank -%}<span class="lrev__date">{{ b.settings.date }}</span>{%- endif -%}
              </div>
              {%- if b.settings.title != blank -%}<h3>{{ b.settings.title }}</h3>{%- endif -%}
              <p class="lrev__body">{{ b.settings.body }}</p>
              {%- if b.settings.name != blank -%}<p class="lrev__who">— {{ b.settings.name }}</p>{%- endif -%}
            </article>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  <template data-kg-star>{{ star }}</template>
</section>
</div>
<script>
(function () {
  var root = document.currentScript.previousElementSibling.querySelector('[data-kg-reviews]');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  var track = root.querySelector('[data-kg-reviews-track]');
  var viewport = root.querySelector('[data-kg-reviews-viewport]');
  var star = root.querySelector('[data-kg-star]').innerHTML;
  var limit = parseInt(root.dataset.limit, 10) || 20;
  var have = track.children.length;
  function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
  function text(html) { var d = document.createElement('div'); d.innerHTML = (html || '').replace(/<br\s*\/?>/gi, '\n').replace(/<\/p>\s*<p>/gi, '\n\n'); return (d.textContent || '').trim(); }
  function stars(n) { var out = ''; for (var i = 1; i <= 5; i++) out += i <= n ? star : star.replace('<svg ', '<svg class="is-empty" '); return out; }
  function fmt(iso) { var d = new Date(iso); return isNaN(d) ? '' : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }
  function setSummary(avg, count) {
    document.querySelectorAll('[data-kg-rating]').forEach(function (el) {
      var a = el.querySelector('[data-kg-avg]'), c = el.querySelector('[data-kg-count]');
      if (a) a.textContent = (Math.round(avg * 10) / 10).toFixed(1);
      if (c) c.textContent = count;
      el.hidden = !count;
    });
  }
  if (have < limit && root.dataset.shop && root.dataset.productId) {
    var url = 'https://judge.me/reviews/reviews_for_widget?url=' + encodeURIComponent(root.dataset.shop) +
      '&shop_domain=' + encodeURIComponent(root.dataset.shop) + '&platform=shopify&page=1&per_page=' + (limit - have) +
      '&product_id=' + encodeURIComponent(root.dataset.productId);
    fetch(url).then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
      if (!d) return;
      if (d.number_of_reviews) setSummary(parseFloat(d.average_rating), d.number_of_reviews);
      (d.reviews || []).slice(0, limit - have).forEach(function (r) {
        var name = !r.reviewer_name || r.reviewer_name === 'Anonymous' ? 'Customer' : r.reviewer_name;
        var slide = document.createElement('div');
        slide.className = 'lrev__slide';
        slide.innerHTML = '<article class="lrev__card"><div class="lrev__top"><div class="lrev__meta"><span class="lrev__stars" aria-label="' + esc(r.rating) + ' out of 5 stars">' + stars(parseInt(r.rating, 10) || 0) + '</span>' +
          (r.verified_buyer ? '<span class="lrev__verified">Verified</span>' : '') + '</div><span class="lrev__date">' + esc(fmt(r.created_at)) + '</span></div>' +
          (r.title ? '<h3>' + esc(r.title) + '</h3>' : '') + '<p class="lrev__body">' + esc(text(r.body_html)) + '</p><p class="lrev__who">— ' + esc(name) + '</p></article>';
        track.appendChild(slide);
      });
    }).catch(function () {});
  }
  /* drag to scroll with a mouse, like the live carousel */
  var down = false, startX = 0, startLeft = 0, moved = false;
  viewport.addEventListener('pointerdown', function (e) { if (e.pointerType !== 'mouse') return; down = true; moved = false; startX = e.clientX; startLeft = viewport.scrollLeft; });
  window.addEventListener('pointermove', function (e) { if (!down) return; var dx = e.clientX - startX; if (Math.abs(dx) > 4) { moved = true; viewport.classList.add('is-dragging'); } viewport.scrollLeft = startLeft - dx; });
  window.addEventListener('pointerup', function () { if (!down) return; down = false; viewport.classList.remove('is-dragging'); });
  viewport.addEventListener('click', function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
})();
</script>
{% schema %}
{
 "name": "KITTED product reviews",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews" },
  { "type": "product", "id": "product", "label": "Product", "info": "Leave empty on product pages to use that product's reviews." },
  { "type": "range", "id": "limit", "label": "Reviews shown", "min": 5, "max": 30, "step": 1, "default": 20 },
  { "type": "checkbox", "id": "stone", "label": "Stone background (unused)", "default": false }
 ],
 "blocks": [
  { "type": "featured", "name": "Featured review", "settings": [
    { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "text", "id": "date", "label": "Date", "info": "e.g. Mar 25, 2026" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "body", "label": "Review" },
    { "type": "text", "id": "name", "label": "Name" }
  ] }
 ],
 "presets": [ { "name": "KITTED product reviews" } ]
}
{% endschema %}

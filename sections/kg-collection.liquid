{%- comment -%}
  KITTED collection grid, matching the live kittedgear.com collection pages:
  back link, "Collection" eyebrow + title, two large cards per row, an optional
  SpinGrip Bundle card and an optional "Team up and save" banner.
{%- endcomment -%}
{%- liquid
  assign back_url = section.settings.back_url
  assign back_label = section.settings.back_label
  case collection.handle
    when 'baseball'
      assign sport_url = '/pages/baseball'
      assign sport_label = 'Baseball'
    when 'spingrip-softball', 'softball'
      assign sport_url = '/pages/softball'
      assign sport_label = 'Softball'
    when 'football'
      assign sport_url = '/pages/football'
      assign sport_label = 'Football'
  endcase
  if back_url == blank
    assign back_url = sport_url | default: routes.root_url
    assign back_label = back_label | default: sport_label | default: 'Home'
  endif
  assign back_label = back_label | default: 'Home'

  assign glove_count = 0
  for p in collection.products
    if p.selected_or_first_available_variant.requires_shipping
      assign glove_count = glove_count | plus: 1
    endif
  endfor
-%}
{%- capture bundle_card -%}
  {%- if section.settings.show_bundle -%}
    <a class="lcard lcard--bundle" href="{{ section.settings.bundle_url | default: '/pages/team-orders' }}">
      <div class="lcard__media lcard__media--contain">
        {%- if section.settings.bundle_image != blank -%}
          {{ section.settings.bundle_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 460px, 50vw', alt: section.settings.bundle_title }}
        {%- else -%}
          <img src="{{ 'kg-spingrip-bundle-card.webp' | asset_url }}" alt="SpinGrip bundle: football, baseball and softball gloves" width="900" height="900" loading="lazy">
        {%- endif -%}
        {%- if section.settings.bundle_tag != blank -%}<span class="lcard__tag">{{ section.settings.bundle_tag }}</span>{%- endif -%}
      </div>
      <div class="lcard__body">
        <h2 class="lcard__name">{{ section.settings.bundle_title }}</h2>
        <p class="lcard__blurb">{{ section.settings.bundle_text }}</p>
        <div class="lcard__foot"><span class="lcard__price">{{ section.settings.bundle_price }}</span><span class="lcard__cta">{{ section.settings.bundle_cta }} <span aria-hidden="true">→</span></span></div>
      </div>
    </a>
  {%- endif -%}
{%- endcapture -%}
<div class="kg">
<section class="lcoll">
  <div class="wrap">
    <a class="lcoll__back" href="{{ back_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg> {{ back_label }}</a>
    <div class="lcoll__head">
      <p class="lcoll__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- liquid
        assign coll_title = collection.title
        if collection.handle == 'all'
          assign coll_title = 'SpinGrip'
        endif
      -%}
      <h1 class="lcoll__title">{{ section.settings.title | default: coll_title }}</h1>
    </div>
    {%- paginate collection.products by 48 -%}
      <div class="lcoll__grid">
        {%- assign shown = 0 -%}
        {%- for p in collection.products -%}
          {%- if p.selected_or_first_available_variant.requires_shipping -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- render 'kg-collection-card', p: p -%}
          {%- endif -%}
        {%- endfor -%}
        {%- comment -%} Live order: several gloves → bundle before the formulas; one glove → bundle last. {%- endcomment -%}
        {%- if glove_count > 1 -%}{{ bundle_card }}{%- endif -%}
        {%- for p in collection.products -%}
          {%- unless p.selected_or_first_available_variant.requires_shipping -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- render 'kg-collection-card', p: p -%}
          {%- endunless -%}
        {%- endfor -%}
        {%- if glove_count <= 1 and shown > 0 -%}{{ bundle_card }}{%- endif -%}
      </div>
      {%- if shown == 0 -%}<p class="muted lcoll__empty">No products in this collection yet.</p>{%- endif -%}
      {%- if paginate.pages > 1 -%}<div class="lcoll__pages">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
  {%- if section.settings.show_team_banner -%}
    <div class="lteam">
      <div class="lteam__text">
        <h2 class="lteam__title">{{ section.settings.team_title }}</h2>
        <p class="lteam__sub">{{ section.settings.team_text }}</p>
        {%- assign chips = section.settings.team_chips | split: ',' -%}
        {%- if chips.size > 0 -%}<div class="lteam__chips">{%- for c in chips -%}<span>{{ c | strip }}</span>{%- endfor -%}</div>{%- endif -%}
      </div>
      <a class="lteam__btn" href="{{ section.settings.team_url | default: '/pages/team-orders' }}">{{ section.settings.team_cta }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  {%- endif -%}
</section>
</div>
{% schema %}
{
 "name": "KITTED collection grid",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection" },
  { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the collection title." },
  { "type": "url", "id": "back_url", "label": "Back link", "info": "Leave empty: sport collections link back to their sport page, others to Home." },
  { "type": "text", "id": "back_label", "label": "Back link text" },
  { "type": "header", "content": "SpinGrip Bundle card" },
  { "type": "checkbox", "id": "show_bundle", "label": "Show bundle card", "default": true },
  { "type": "url", "id": "bundle_url", "label": "Bundle link", "info": "Where 'Build your pack' goes." },
  { "type": "image_picker", "id": "bundle_image", "label": "Bundle image" },
  { "type": "text", "id": "bundle_tag", "label": "Bundle tag", "default": "Save up to 20%" },
  { "type": "text", "id": "bundle_title", "label": "Bundle title", "default": "SpinGrip Bundle" },
  { "type": "text", "id": "bundle_text", "label": "Bundle text", "default": "Build your SpinGrip bundle pack: any glove, any size, any hand. Save up to 20%." },
  { "type": "text", "id": "bundle_price", "label": "Bundle price line", "default": "2 · 5 · 10 Packs" },
  { "type": "text", "id": "bundle_cta", "label": "Bundle link text", "default": "Build your pack" },
  { "type": "header", "content": "Team up and save banner" },
  { "type": "checkbox", "id": "show_team_banner", "label": "Show banner", "default": true },
  { "type": "text", "id": "team_title", "label": "Title", "default": "Team up and save" },
  { "type": "text", "id": "team_text", "label": "Text", "default": "Now offering SpinGrip Packs. Any glove. Any size." },
  { "type": "text", "id": "team_chips", "label": "Tags", "info": "Comma separated.", "default": "2-Pack · Save 10%, 5-Pack · Save 15%, 10-Pack · Save 20%" },
  { "type": "text", "id": "team_cta", "label": "Button text", "default": "Build your pack" },
  { "type": "url", "id": "team_url", "label": "Button link" }
 ]
}
{% endschema %}

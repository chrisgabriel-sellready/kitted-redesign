<div class="kg">
<section class="section" style="padding-top:clamp(28px,4vw,48px)"><div class="wrap article">
<aside><nav aria-label="In this guide" class="toc"><p class="eyebrow muted" style="margin-bottom:6px">{{ section.settings.t1 }}</p><a href="#effect">{{ section.settings.t2 }}</a><a href="#release">{{ section.settings.t3 }}</a><a href="#pitchers">{{ section.settings.t4 }}</a><a href="#position">{{ section.settings.t5 }}</a><a href="#qbs">{{ section.settings.t6 }}</a><a href="#faq">{{ section.settings.t7 }}</a></nav></aside>
<article class="prose">
<h2 id="effect" style="margin-top:0">{{ section.settings.t8 }}</h2>
<p>{{ section.settings.t9 }}</p>
<p>{{ section.settings.t10 }}</p>
<div class="pillars">{%- for block in section.blocks -%}{%- case block.type -%}{%- when "c1a" -%}<div {{ block.shopify_attributes }}><b>{{ block.settings.t1 }}</b><span>{{ block.settings.t2 }}</span></div>{%- endcase -%}{%- endfor -%}</div>
<p>{{ section.settings.t11 }}</p>
<p>{{ section.settings.t12 }}</p>
<p>{{ section.settings.t13 }}</p>
<figure>{%- assign kg_alt = section.settings.t16 | escape -%}{%- if section.settings.i14 != blank -%}{{ section.settings.i14 | image_url: width: 1800 | image_tag: alt: kg_alt, loading: "lazy" }}{%- else -%}<img src="{{ section.settings.t15 | asset_url }}" alt="{{ section.settings.t16 | escape }}" width="1600" height="1275" loading="lazy">{%- endif -%}<figcaption>{{ section.settings.t17 }}</figcaption></figure>
<h2 id="release">{{ section.settings.t18 }}</h2>
<p>{{ section.settings.t19 }}</p>
<p>{{ section.settings.t20 }}</p>
<p>{{ section.settings.t21 }}</p>
<div class="callout"><p class="eyebrow" style="color:var(--gold)">{{ section.settings.t22 }}</p><p class="display">{{ section.settings.t23 }}</p><div class="btn-row"><a class="btn btn--light" href="{{ section.settings.u24 }}">{{ section.settings.t25 }}<svg aria-hidden="true" class="arrow" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></div><p style="color:var(--mute-on-ink);font-size:13px">{{ section.settings.i26 }}</p></div>
<h2 id="pitchers">{{ section.settings.t27 }}</h2>
<p>{{ section.settings.t28 }}</p>
<ul>{%- for block in section.blocks -%}{%- case block.type -%}{%- when "c2a" -%}<li {{ block.shopify_attributes }}>{{ block.settings.i1 }}</li>{%- endcase -%}{%- endfor -%}</ul>
<p>{{ section.settings.i29 }}</p>
<h2 id="position">{{ section.settings.t30 }}</h2>
<p>{{ section.settings.t31 }}</p>
<ul>{%- for block in section.blocks -%}{%- case block.type -%}{%- when "c3a" -%}<li {{ block.shopify_attributes }}>{{ block.settings.i1 }}</li>{%- endcase -%}{%- endfor -%}</ul>
<p>{{ section.settings.i32 }}</p>
<h2 id="qbs">{{ section.settings.t33 }}</h2>
<p>{{ section.settings.t34 }}</p>
<ul>{%- for block in section.blocks -%}{%- case block.type -%}{%- when "c4a" -%}<li {{ block.shopify_attributes }}>{{ block.settings.i1 }}</li>{%- endcase -%}{%- endfor -%}</ul>
<p>{{ section.settings.t35 }}</p>
<figure>{%- assign kg_alt = section.settings.t38 | escape -%}{%- if section.settings.i36 != blank -%}{{ section.settings.i36 | image_url: width: 1800 | image_tag: alt: kg_alt, loading: "lazy" }}{%- else -%}<img src="{{ section.settings.t37 | asset_url }}" alt="{{ section.settings.t38 | escape }}" width="1200" height="800" loading="lazy">{%- endif -%}</figure>
<h2 id="faq">{{ section.settings.t39 }}</h2>
<div class="faq-list" style="margin:0;max-width:none">{%- for block in section.blocks -%}{%- case block.type -%}{%- when "c5a" -%}<details {{ block.shopify_attributes }} class="acc"><summary>{{ block.settings.t1 }}<span aria-hidden="true" class="pm"></span></summary><div class="acc__body"><p>{{ block.settings.t2 }}</p></div></details>{%- endcase -%}{%- endfor -%}</div>
</article>
</div></section>
</div>


{%- comment -%}
  KITTED Kollective popup, rebuilt from the old kittedgear.com site: opens a few
  seconds into a visit, live jersey preview, name / jersey # / email / mobile,
  SMS consent, "Join the Roster". Closing it leaves a "Get 10% off" tab that
  reopens it. Sign-ups go to the Klaviyo list (email always, SMS when opted in)
  and are also saved as Shopify customers, exactly like the Kollective band.
{%- endcomment -%}
{%- liquid
  assign kp_skip = false
  if template.name == 'cart' or template.name == 'password' or template.name contains 'customers'
    assign kp_skip = true
  endif
  if template.name == 'index' and template.suffix == 'kollective'
    assign kp_skip = true
  endif
  if section.settings.enabled == false
    assign kp_skip = true
  endif
-%}
{%- unless kp_skip -%}
<div class="kg kpop" data-kpop data-delay="{{ section.settings.delay }}" data-days="{{ section.settings.days }}" hidden>
  <div class="kpop__overlay" data-kpop-close></div>
  <div class="kpop__dialog" role="dialog" aria-modal="true" aria-labelledby="kpop-title" data-jersey-scope>
    <button type="button" class="kpop__close" data-kpop-close aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    <div class="kpop__body" data-kpop-form-view>
      <p class="kpop__tag">{{ section.settings.tag }}</p>
      <h2 class="kpop__title" id="kpop-title">{{ section.settings.heading }}</h2>
      <p class="kpop__text">{{ section.settings.text }}</p>
      <p class="kpop__badge"><span class="kpop__dot"></span>{{ section.settings.badge }}</p>
      <div class="kpop__jersey"><svg class="jersey-svg" viewBox="0 0 600 300" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" aria-label="KITTED jersey YOUR NAME number 00"><defs><pattern id="kp-pin" width="11" height="11" patternUnits="userSpaceOnUse"><rect width="11" height="11" fill="#fbfaf5"></rect><rect x="5" width="1" height="11" fill="#14213d" opacity="0.6"></rect></pattern><linearGradient id="kp-shade" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#000" stop-opacity="0.14"></stop><stop offset="0.25" stop-color="#000" stop-opacity="0"></stop><stop offset="0.75" stop-color="#000" stop-opacity="0"></stop><stop offset="1" stop-color="#000" stop-opacity="0.14"></stop></linearGradient><clipPath id="kp-bodyclip"><path d="M108 26 Q150 50 192 26 L250 50 Q270 70 288 118 L246 140 L234 116 L236 284 Q150 292 64 284 L66 116 L54 140 L12 118 Q30 70 50 50 Z"></path></clipPath><path id="kp-arch" d="M80 100 Q150 76 220 100"></path></defs><g><path d="M108 26 Q150 50 192 26 L250 50 Q270 70 288 118 L246 140 L234 116 L236 284 Q150 292 64 284 L66 116 L54 140 L12 118 Q30 70 50 50 Z" fill="url(#kp-pin)"></path><g clip-path="url(#kp-bodyclip)"><rect width="300" height="300" fill="url(#kp-shade)"></rect><path d="M60 276 Q150 284 240 276" stroke="#14213d" stroke-width="5" fill="none"></path><rect x="146" y="64" width="8" height="220" fill="#14213d" opacity="0.12"></rect><line x1="150" y1="64" x2="150" y2="284" stroke="#14213d" stroke-width="1.5"></line><circle cx="150" cy="70" r="2.6" fill="#fff" stroke="#14213d" stroke-width="1"></circle><circle cx="150" cy="110" r="2.6" fill="#fff" stroke="#14213d" stroke-width="1"></circle><circle cx="150" cy="150" r="2.6" fill="#fff" stroke="#14213d" stroke-width="1"></circle><circle cx="150" cy="190" r="2.6" fill="#fff" stroke="#14213d" stroke-width="1"></circle><circle cx="150" cy="230" r="2.6" fill="#fff" stroke="#14213d" stroke-width="1"></circle><circle cx="150" cy="266" r="2.6" fill="#fff" stroke="#14213d" stroke-width="1"></circle></g><path d="M108 26 Q150 50 192 26 L250 50 Q270 70 288 118 L246 140 L234 116 L236 284 Q150 292 64 284 L66 116 L54 140 L12 118 Q30 70 50 50 Z" fill="none" stroke="#14213d" stroke-width="2.5" stroke-linejoin="round"></path><path d="M108 28 L150 60 L192 28" fill="none" stroke="#14213d" stroke-width="7" stroke-linejoin="round" stroke-linecap="round"></path><path d="M113 34 L150 63 L187 34" fill="none" stroke="#b31b2c" stroke-width="2" stroke-linejoin="round"></path><path d="M15 112 L57 132" stroke="#14213d" stroke-width="7"></path><path d="M18 106 L59 126" stroke="#b31b2c" stroke-width="2"></path><path d="M285 112 L243 132" stroke="#14213d" stroke-width="7"></path><path d="M282 106 L241 126" stroke="#b31b2c" stroke-width="2"></path><circle cx="96" cy="78" r="17" fill="#14213d" stroke="#b31b2c" stroke-width="2.5"></circle><circle cx="96" cy="78" r="13.5" fill="none" stroke="#fff" stroke-width="0.8" stroke-dasharray="1.6 1.6"></circle><text x="96" y="83" text-anchor="middle" fill="#fff" font-family="'Barlow Condensed', Impact, sans-serif" font-weight="900" font-size="13" letter-spacing="0.5">KG</text><image href="{{ 'kg-k-black.png' | asset_url }}" xlink:href="{{ 'kg-k-black.png' | asset_url }}" x="194" y="68" width="18" height="18" preserveAspectRatio="xMidYMid meet"></image><text x="150" y="138" text-anchor="middle" fill="#14213d" stroke="#b31b2c" stroke-width="2.5" paint-order="stroke" stroke-linejoin="round" font-family="'Barlow Condensed', Impact, sans-serif" font-weight="900" font-style="italic" font-size="44" letter-spacing="3" transform="rotate(-6 150 130)">KITTED</text><g font-family="'Barlow Condensed', Impact, sans-serif" font-weight="900" font-size="40" text-anchor="middle"><text x="196" y="196" fill="#14213d" stroke="#14213d" stroke-width="5" stroke-linejoin="round"><tspan data-j-num>00</tspan></text><text x="196" y="196" fill="#b31b2c"><tspan data-j-num>00</tspan></text></g></g><g transform="translate(300 0)"><path d="M108 26 Q150 50 192 26 L250 50 Q270 70 288 118 L246 140 L234 116 L236 284 Q150 292 64 284 L66 116 L54 140 L12 118 Q30 70 50 50 Z" fill="url(#kp-pin)"></path><g clip-path="url(#kp-bodyclip)"><rect width="300" height="300" fill="url(#kp-shade)"></rect><path d="M100 150 Q110 210 96 280" stroke="#000" stroke-opacity="0.06" stroke-width="6" fill="none"></path><path d="M205 160 Q195 220 208 282" stroke="#000" stroke-opacity="0.06" stroke-width="6" fill="none"></path><path d="M60 276 Q150 284 240 276" stroke="#14213d" stroke-width="5" fill="none"></path></g><path d="M108 26 Q150 50 192 26 L250 50 Q270 70 288 118 L246 140 L234 116 L236 284 Q150 292 64 284 L66 116 L54 140 L12 118 Q30 70 50 50 Z" fill="none" stroke="#14213d" stroke-width="2.5" stroke-linejoin="round"></path><path d="M108 28 Q150 52 192 28" fill="none" stroke="#14213d" stroke-width="7" stroke-linejoin="round" stroke-linecap="round"></path><path d="M111 33 Q150 55 189 33" fill="none" stroke="#b31b2c" stroke-width="2" stroke-linejoin="round"></path><path d="M15 112 L57 132" stroke="#14213d" stroke-width="7"></path><path d="M18 106 L59 126" stroke="#b31b2c" stroke-width="2"></path><path d="M285 112 L243 132" stroke="#14213d" stroke-width="7"></path><path d="M282 106 L241 126" stroke="#b31b2c" stroke-width="2"></path><text fill="#14213d" font-family="'Barlow Condensed', Impact, sans-serif" font-weight="900" font-size="24" letter-spacing="2" text-anchor="middle"><textPath href="#kp-arch" xlink:href="#kp-arch" startOffset="50%" data-j-name>YOUR NAME</textPath></text><g font-family="'Barlow Condensed', Impact, sans-serif" font-weight="900" font-size="100" text-anchor="middle"><text x="150" y="200" fill="#14213d" stroke="#14213d" stroke-width="9" stroke-linejoin="round"><tspan data-j-num>00</tspan></text><text x="150" y="200" fill="#b31b2c"><tspan data-j-num>00</tspan></text></g></g></svg></div>
      {%- form 'customer', id: 'kpop-form', class: 'kpop__form', data-jersey: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="contact[tags]" value="kollective">
        <input type="hidden" name="contact[first_name]"><input type="hidden" name="contact[last_name]">
        <label class="visually-hidden" for="kpop-name">First and last name</label>
        <input id="kpop-name" name="fullname" placeholder="First and Last Name" autocomplete="name" required>
        <label class="visually-hidden" for="kpop-num">Jersey number (0–99)</label>
        <input id="kpop-num" name="number" inputmode="numeric" maxlength="2" placeholder="Jersey # (0–99)">
        <label class="visually-hidden" for="kpop-email">Email address</label>
        <input id="kpop-email" name="contact[email]" type="email" placeholder="Email address" autocomplete="email" required>
        <label class="visually-hidden" for="kpop-phone">Mobile number</label>
        <input id="kpop-phone" name="contact[phone]" type="tel" placeholder="Mobile number" autocomplete="tel">
        <p class="kpop__msg" role="alert" data-kpop-msg hidden></p>
        <button class="kpop__submit" type="submit">{{ section.settings.button }}</button>
        <label class="kpop__consent"><input type="checkbox" name="contact[accepts_marketing]" value="true" checked><span>{{ section.settings.consent | remove: '<p>' | remove: '</p>' }}</span></label>
      {%- endform -%}
    </div>
    <div class="kpop__body kpop__done" data-kpop-done hidden>
      <p class="kpop__tag">{{ section.settings.tag }}</p>
      <h2 class="kpop__title">{{ section.settings.success_heading }}</h2>
      <p class="kpop__text">{{ section.settings.success }}</p>
      <button type="button" class="kpop__submit" data-kpop-close>{{ section.settings.success_button }}</button>
    </div>
  </div>
</div>
<div class="kg kpop-tab" data-kpop-tab hidden><button type="button" class="kpop-tab__open" data-kpop-open>{{ section.settings.tab }}</button><button type="button" class="kpop-tab__x" data-kpop-tab-close aria-label="Dismiss">×</button></div>
<script>
(function () {
  var root = document.querySelector('[data-kpop]'); if (!root || root.dataset.ready) return; root.dataset.ready = '1';
  var tab = document.querySelector('[data-kpop-tab]');
  var form = document.getElementById('kpop-form');
  var msg = root.querySelector('[data-kpop-msg]');
  var company = {{ section.settings.klaviyo_company_id | default: 'VvsiAM' | json }};
  var listId = {{ section.settings.klaviyo_list_id | default: 'Y4syAV' | json }};
  var source = {{ section.settings.klaviyo_source | default: 'KITTED Kollective VIP' | json }};
  var offer = {{ section.settings.klaviyo_offer | default: 'kitted10' | json }};
  var delay = (parseInt(root.dataset.delay, 10) || 0) * 1000;
  var days = parseInt(root.dataset.days, 10); if (isNaN(days)) days = 7;
  var K = 'kgKollectivePopup';
  function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function sget(k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } }
  function sset(k, v) { try { sessionStorage.setItem(k, v); } catch (e) {} }
  var joined = get(K + 'Joined') === '1';
  var closedAt = parseInt(get(K + 'Closed') || '0', 10);
  var lastFocus = null;
  function open() {
    lastFocus = document.activeElement;
    root.hidden = false; document.documentElement.classList.add('kpop-lock');
    if (tab) tab.hidden = true;
    var first = root.querySelector('#kpop-name'); if (first) setTimeout(function () { first.focus({ preventScroll: true }); }, 50);
  }
  function close() {
    root.hidden = true; document.documentElement.classList.remove('kpop-lock');
    if (!joined) { set(K + 'Closed', String(Date.now())); if (tab && sget(K + 'TabHidden') !== '1') tab.hidden = false; }
    if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
  }
  root.querySelectorAll('[data-kpop-close]').forEach(function (el) { el.addEventListener('click', close); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !root.hidden) close(); });
  if (tab) {
    tab.querySelector('[data-kpop-open]').addEventListener('click', open);
    tab.querySelector('[data-kpop-tab-close]').addEventListener('click', function () { tab.hidden = true; sset(K + 'TabHidden', '1'); });
  }
  document.querySelectorAll('a[href="#kollective-popup"]').forEach(function (a) { a.addEventListener('click', function (e) { e.preventDefault(); open(); }); });
  if (!joined && !(window.Shopify && window.Shopify.designMode)) {
    var recentlyClosed = closedAt && (Date.now() - closedAt) < days * 864e5;
    if (recentlyClosed) { if (tab && sget(K + 'TabHidden') !== '1') tab.hidden = false; }
    else setTimeout(function () { if (root.hidden && !get(K + 'Joined')) open(); }, delay);
  }
  function e164(raw) {
    var d = (raw || '').replace(/[^\d+]/g, '');
    if (/^\+\d{8,15}$/.test(d)) return d;
    d = d.replace(/\D/g, '');
    if (d.length === 10) return '+1' + d;
    if (d.length === 11 && d.charAt(0) === '1') return '+' + d;
    return '';
  }
  function showMsg(t) { msg.textContent = t; msg.hidden = !t; }
  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    var parts = (form.querySelector('[name=fullname]').value || '').trim().split(/\s+/);
    var first = parts.shift() || '', last = parts.join(' ');
    var email = (form.querySelector('[name="contact[email]"]').value || '').trim();
    if (!first) { showMsg('Please enter your name.'); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showMsg('Please enter a valid email address.'); return; }
    var phoneIn = form.querySelector('[name="contact[phone]"]');
    var rawPhone = (phoneIn.value || '').trim(), phone = e164(rawPhone);
    if (rawPhone && !phone) { showMsg('Please enter a valid mobile number, or leave it blank.'); return; }
    showMsg('');
    var n = (form.querySelector('[name=number]').value || '').replace(/\D/g, '').slice(0, 2);
    var consent = form.querySelector('[name="contact[accepts_marketing]"]').checked;
    form.querySelector('[name="contact[first_name]"]').value = first;
    form.querySelector('[name="contact[last_name]"]').value = last;
    form.querySelector('[name="contact[tags]"]').value = 'kollective' + (n ? ',jersey-' + n : '');
    phoneIn.value = phone;
    var btn = form.querySelector('[type=submit]'); btn.disabled = true; var label = btn.textContent; btn.textContent = 'Joining…';
    var props = { signup_offer: offer }; if (n) props.jersey_number = n;
    var subs = { email: { marketing: { consent: 'SUBSCRIBED' } } };
    var attrs = { email: email, first_name: first, last_name: last, properties: props, subscriptions: subs };
    if (phone && consent) { attrs.phone_number = phone; subs.sms = { marketing: { consent: 'SUBSCRIBED' } }; }
    var body = { data: { type: 'subscription', attributes: { custom_source: source, profile: { data: { type: 'profile', attributes: attrs } } }, relationships: { list: { data: { type: 'list', id: listId } } } } };
    var toKlaviyo = fetch('https://a.klaviyo.com/client/subscriptions?company_id=' + encodeURIComponent(company), {
      method: 'POST', headers: { 'Content-Type': 'application/vnd.api+json', 'revision': '2025-07-15' }, body: JSON.stringify(body)
    }).then(function (r) { return r.ok; }).catch(function () { return false; });
    var toShopify = fetch(form.getAttribute('action') || '/contact', { method: 'POST', body: new FormData(form), credentials: 'same-origin' }).catch(function () {});
    Promise.all([toKlaviyo, toShopify]).then(function (res) {
      btn.disabled = false; btn.textContent = label;
      if (!res[0]) { showMsg('Something went wrong. Please try again.'); return; }
      joined = true; set(K + 'Joined', '1');
      root.querySelector('[data-kpop-form-view]').hidden = true;
      root.querySelector('[data-kpop-done]').hidden = false;
      if (tab) tab.hidden = true;
    });
  });
})();
</script>
{%- endunless -%}
{% schema %}
{
 "name": "KITTED Kollective popup",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "checkbox",
   "id": "enabled",
   "label": "Show popup",
   "default": true
  },
  {
   "type": "range",
   "id": "delay",
   "label": "Open after (seconds)",
   "min": 0,
   "max": 30,
   "step": 1,
   "default": 3
  },
  {
   "type": "range",
   "id": "days",
   "label": "Don't reopen for (days) after closing",
   "min": 0,
   "max": 30,
   "step": 1,
   "default": 7
  },
  {
   "type": "text",
   "id": "tag",
   "label": "Tag",
   "default": "Early roster access"
  },
  {
   "type": "text",
   "id": "heading",
   "label": "Heading",
   "default": "The KITTED Kollective"
  },
  {
   "type": "textarea",
   "id": "text",
   "label": "Text",
   "default": "Special things are coming. Join The KITTED Kollective to get first access to new KITTED drops before they go public."
  },
  {
   "type": "text",
   "id": "badge",
   "label": "Badge",
   "default": "10% off your first order"
  },
  {
   "type": "text",
   "id": "button",
   "label": "Button",
   "default": "Join the Roster"
  },
  {
   "type": "richtext",
   "id": "consent",
   "label": "SMS consent text",
   "default": "<p>Yes, text me. By checking this box and providing my mobile number, I agree to receive recurring automated marketing text messages from KITTED at the number provided. Consent is not a condition of purchase. Message and data rates may apply. Reply STOP to opt out, HELP for help. See our <a href=\"/policies/privacy-policy\">Privacy Policy</a> and <a href=\"/policies/terms-of-service\">Terms</a>.</p>"
  },
  {
   "type": "text",
   "id": "tab",
   "label": "Corner tab text",
   "default": "Get 10% off"
  },
  {
   "type": "text",
   "id": "success_heading",
   "label": "Thank-you heading",
   "default": "You're on the roster"
  },
  {
   "type": "textarea",
   "id": "success",
   "label": "Thank-you text",
   "default": "Watch your inbox for early access and your 10% code."
  },
  {
   "type": "text",
   "id": "success_button",
   "label": "Thank-you button",
   "default": "Keep shopping"
  },
  {
   "type": "header",
   "content": "Klaviyo"
  },
  {
   "type": "text",
   "id": "klaviyo_company_id",
   "label": "Klaviyo public API key (company ID)",
   "default": "VvsiAM"
  },
  {
   "type": "text",
   "id": "klaviyo_list_id",
   "label": "Klaviyo list ID",
   "default": "Y4syAV",
   "info": "KITTED Kollective"
  },
  {
   "type": "text",
   "id": "klaviyo_source",
   "label": "Klaviyo source",
   "default": "KITTED Kollective VIP"
  },
  {
   "type": "text",
   "id": "klaviyo_offer",
   "label": "Sign-up offer property",
   "default": "kitted10"
  }
 ],
 "enabled_on": {
  "groups": [
   "footer"
  ]
 }
}
{% endschema %}

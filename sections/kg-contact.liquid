<div class="kg">
<div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span>{{ section.settings.heading }}</span></nav>
  <div class="page-head"><h1 class="page-title">{{ section.settings.heading }}</h1><p class="lede muted">{{ section.settings.text }}</p></div>
  <div class="contact" style="padding-bottom:var(--section)">
    <aside class="stack" style="gap:20px">
      <div class="bulk"><p class="eyebrow">Bulk &amp; team orders</p><h2 class="h-card">Outfitting a team, club or organization?</h2><p class="muted" style="font-size:14px">Save more when you order 10+ gloves.</p>
        <a href="/pages/team-orders">View bulk order pricing and contact details</a></div>
      <div class="stack" style="gap:6px;font-size:14px"><p class="eyebrow muted">Email</p><p style="user-select:all">{{ section.settings.email }}</p></div>
      <div class="stack" style="gap:6px;font-size:14px"><p class="eyebrow muted">Shipping</p><p>{{ section.settings.shipping }}</p></div>
    </aside>
    {%- form 'contact', class: 'form-grid' -%}
      {%- if form.posted_successfully? -%}<p class="form-msg full is-ok" role="status">{{ section.settings.success }}</p>{%- endif -%}
      {%- if form.errors -%}<div class="form-msg full is-warn" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="kg-field"><label for="c-name">Name</label><input id="c-name" name="contact[name]" autocomplete="name" required value="{{ form.name }}"></div>
      <div class="kg-field"><label for="c-email">Email</label><input id="c-email" name="contact[email]" type="email" autocomplete="email" required value="{{ form.email }}"></div>
      <div class="kg-field full"><label for="c-phone">Phone number</label><input id="c-phone" name="contact[phone]" type="tel" autocomplete="tel" value="{{ form.phone }}"></div>
      <div class="kg-field full"><label for="c-msg">Comment</label><textarea id="c-msg" name="contact[body]" required>{{ form.body }}</textarea></div>
      <div class="full"><button class="btn btn--lg" type="submit">Send</button></div>
    {%- endform -%}
  </div>
</div>
</div>
{% schema %}
{
 "name": "KITTED contact form",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "text",
   "id": "heading",
   "label": "Heading",
   "default": "Contact us"
  },
  {
   "type": "textarea",
   "id": "text",
   "label": "Text",
   "default": "Questions or inquiries? Fill out the form and our team will get back to you. For order questions, include your order number."
  },
  {
   "type": "text",
   "id": "email",
   "label": "Email shown",
   "default": "Contact@kittedgear.com"
  },
  {
   "type": "text",
   "id": "shipping",
   "label": "Shipping note",
   "default": "Orders ship within 1\u20132 business days. Standard delivery is 3\u20137 business days."
  },
  {
   "type": "text",
   "id": "success",
   "label": "Success message",
   "default": "Thanks. Your message is in. We'll reply by email."
  }
 ],
 "presets": [
  {
   "name": "KITTED contact form"
  }
 ]
}
{% endschema %}

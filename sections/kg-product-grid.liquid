<div class="kg">
<section class="section{% if section.settings.band != 'none' %} band--{{ section.settings.band }}{% endif %}">
  <div class="wrap">
    <div class="section-head section-head--row"><div>
      {%- if section.settings.heading != blank -%}<h2 class="h-section">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="lede muted">{{ section.settings.text }}</p>{%- endif -%}
    </div>{%- if section.settings.button_label != blank -%}<a class="btn btn--outline" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{%- endif -%}</div>
    <div class="grid grid--5">
      {%- assign shown = 0 -%}
      {%- for p in section.settings.collection.products -%}
        {%- if section.settings.gloves_only and p.selected_or_first_available_variant.requires_shipping == false -%}{%- continue -%}{%- endif -%}
        {%- render 'kg-card', p: p -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
      {%- else -%}
        <p class="muted">Choose a collection for this section in the theme editor.</p>
      {%- endfor -%}
    </div>
  </div>
</section>
</div>
{% schema %}
{
 "name": "KITTED product grid",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "text",
   "id": "heading",
   "label": "Heading",
   "default": "Shop SpinGrip"
  },
  {
   "type": "text",
   "id": "text",
   "label": "Text",
   "default": "One glove for every throwing sport. Patent pending, and trusted by 50,000+ athletes."
  },
  {
   "type": "collection",
   "id": "collection",
   "label": "Collection"
  },
  {
   "type": "checkbox",
   "id": "gloves_only",
   "label": "Gloves only (hide digital programs)",
   "default": true
  },
  {
   "type": "range",
   "id": "limit",
   "label": "Products to show",
   "min": 2,
   "max": 12,
   "step": 1,
   "default": 5
  },
  {
   "type": "text",
   "id": "button_label",
   "label": "Button label",
   "default": "Shop all"
  },
  {
   "type": "url",
   "id": "button_link",
   "label": "Button link"
  },
  {
   "type": "select",
   "id": "band",
   "label": "Background",
   "default": "none",
   "options": [
    {
     "value": "none",
     "label": "White"
    },
    {
     "value": "stone",
     "label": "Stone"
    },
    {
     "value": "ink",
     "label": "Dark"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "KITTED product grid"
  }
 ]
}
{% endschema %}

<div class="kg">
<section class="section">
<div class="wrap split">
<div class="split__media" style="order:2"><div style="max-width:380px;margin-inline:auto"><figure class="vcard" data-video="" style="margin:0">
<div class="vcard__frame">{% render 'kg-video-card-media', video: section.settings.kg_video, url: section.settings.kg_video_url, image: section.settings.i1, poster: section.settings.t2 %}</div>
</figure></div></div>
<div class="split__text">
<p class="eyebrow">{{ section.settings.t3 }}</p>
<h2 class="h-section">{{ section.settings.t4 }}</h2>
<p class="lede">{{ section.settings.t5 }}</p>
<div class="btn-row"><a class="btn" href="{{ section.settings.kg_shop_url | default: '#buy' }}">{{ section.settings.t6 }}<svg aria-hidden="true" class="arrow" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></div>
</div>
</div>
</section>
</div>

{% schema %}
{
 "name": "KITTED: The #1 throwing m",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "image_picker",
   "id": "i1",
   "label": "Image"
  },
  {
   "type": "text",
   "id": "t2",
   "label": "Built-in image (used when no image is pi",
   "default": "kg-poster-softball-d1-problem.webp"
  },
  {
   "type": "text",
   "id": "t3",
   "label": "Eyebrow: D1 athlete breaks it dow..."
  },
  {
   "type": "text",
   "id": "t4",
   "label": "Heading: The #1 throwing mistake ..."
  },
  {
   "type": "textarea",
   "id": "t5",
   "label": "Text: A former D1 softball ath..."
  },
  {
   "type": "text",
   "id": "t6",
   "label": "Link text: Shop SpinGrip"
  },
  {
   "type": "video",
   "id": "kg_video",
   "label": "Video (Shopify file)"
  },
  {
   "type": "url",
   "id": "kg_video_url",
   "label": "Video URL",
   "info": "Use a permanent Shopify-hosted file before changing the domain."
  },
  {
   "type": "url",
   "id": "kg_shop_url",
   "label": "Shop button link",
   "info": "Leave empty to scroll to the buy box on this page."
  }
 ],
 "presets": [
  {
   "name": "KITTED: The #1 throwing m"
  }
 ]
}
{% endschema %}

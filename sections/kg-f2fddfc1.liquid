<div class="kg">
<section class="section">
<div class="wrap">
<h2 class="h-section" style="margin-bottom:clamp(20px,3vw,32px)">{{ section.settings.t1 }}</h2>
<div class="faq-panel"><div class="faq-list">{%- for block in section.blocks -%}{%- case block.type -%}{%- when "c1a" -%}<details {{ block.shopify_attributes }} class="acc"><summary>{{ block.settings.t1 }}<span aria-hidden="true" class="pm"></span></summary><div class="acc__body"><p>{{ block.settings.t2 }}</p></div></details>{%- when "c1b" -%}<details {{ block.shopify_attributes }} class="acc"><summary>{{ block.settings.t1 }}<span aria-hidden="true" class="pm"></span></summary><div class="acc__body"><p>{{ block.settings.h2 }}</p></div></details>{%- when "c1c" -%}<details {{ block.shopify_attributes }} class="acc"><summary>{{ block.settings.t1 }}<span aria-hidden="true" class="pm"></span></summary><div class="acc__body"><p>{{ block.settings.i2 }}</p></div></details>{%- endcase -%}{%- endfor -%}</div></div>
</div>
</section>
</div>


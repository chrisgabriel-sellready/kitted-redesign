<div class="kg">
<section class="section band--ink">
<div class="wrap final-cta">
<span class="pill">{{ section.settings.h1 }}</span>
<h2 class="display">{{ section.settings.t2 }}</h2>
<p class="lede" style="color:var(--mute-on-ink)">{{ section.settings.t3 }}</p>
<a class="btn btn--light btn--lg" href="{{ section.settings.u4 }}">{{ section.settings.t5 }}<svg aria-hidden="true" class="arrow" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
</div>
</section>
</div>

{% schema %}
{
 "name": "KITTED: The pros do it 2",

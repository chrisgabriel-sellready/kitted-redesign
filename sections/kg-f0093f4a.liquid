   "label": "Text: Limited stock available"
  },
  {
   "type": "text",
   "id": "t2",
   "label": "Heading: The pros do it. Now you ..."
  },
  {
   "type": "textarea",
   "id": "t3",
   "label": "Text: Every throw without Spin..."
  },
  {
   "type": "url",
   "id": "u4",
   "label": "Button link"
  },
  {
   "type": "text",
   "id": "t5",
   "label": "Link text: Shop SpinGrip"
  }
 ],
 "presets": [
  {
   "name": "KITTED: The pros do it 2"
  }
 ]
}
{% endschema %}

<div class="kg">
<section class="section band--ink">
<div class="wrap final-cta">
<span class="pill">{{ section.settings.h1 }}</span>
<h2 class="display">{{ section.settings.t2 }}</h2>
<p class="lede" style="color:var(--mute-on-ink)">{{ section.settings.t3 }}</p>
<a class="btn btn--light btn--lg" href="#buy">{{ section.settings.t4 }}<svg aria-hidden="true" class="arrow" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
</div>
</section>
</div>

{% schema %}
{
 "name": "KITTED: The pros do it. N",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "html",
   "id": "h1",
   "label": "Text: Limited stock available",
   "default": "<span class=\"dot\"></span>Limited stock available"
  },
  {
   "type": "text",
   "id": "t2",
   "label": "Heading: The pros do it. Now you …",
   "default": "The pros do it. Now you can too."
  },
  {
   "type": "textarea",
   "id": "t3",
   "label": "Text: Every throw without Spin…",
   "default": "Every throw without SpinGrip is a missed opportunity. Join the fastpitch athletes throwing harder, spinning more, and hitting their spots with confidence."
  },
  {
   "type": "text",
   "id": "t4",
   "label": "Link text: Shop SpinGrip",
   "default": "Shop SpinGrip"
  }
 ],
 "presets": [
  {
   "name": "KITTED: The pros do it. N"
  }
 ]
}
{% endschema %}

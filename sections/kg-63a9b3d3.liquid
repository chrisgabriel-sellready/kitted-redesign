{% if template.name == 'product' %}
{% render 'kg-live-video-carousel', blocks: section.blocks, title: section.settings.t1, text: section.settings.t2 %}
{% else %}
<div class="kg">
<section class="section">
<div class="wrap">
<div class="section-head section-head--row"><div><h2 class="h-section">{{ section.settings.t1 }}</h2><p class="lede muted">{{ section.settings.t2 }}</p></div><div class="carousel__nav"><button aria-label="Previous" class="carousel__btn" data-car="car-ugc" data-dir="-1" type="button"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"></path></svg></button><button aria-label="Next" class="carousel__btn" data-car="car-ugc" data-dir="1" type="button"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"></path></svg></button></div></div>
<div class="carousel" id="car-ugc"><div class="carousel__track">{%- for block in section.blocks -%}{%- case block.type -%}{%- when "c1a" -%}<figure {{ block.shopify_attributes }} class="vcard" data-video="" style="margin:0">
<div class="vcard__frame">{% render 'kg-video-card-media', video: block.settings.kg_video, url: block.settings.kg_video_url, image: block.settings.i1, poster: block.settings.t2 %}</div>
<div class="vcard__cap"><p class="vcard__quote">{{ block.settings.t3 }}</p><p class="vcard__who">{{ block.settings.t4 }}</p></div>
</figure>{%- endcase -%}{%- endfor -%}</div></div>
</div>
</section>
</div>

{% endif %}
{% schema %}
{
 "name": "KITTED: Real ballplaye 2",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "text",
   "id": "t1",
   "label": "Heading: Real ballplayers. Real r..."
  },
  {
   "type": "text",
   "id": "t2",
   "label": "Text: Don't take our word for ..."
  }
 ],
 "blocks": [
  {
   "type": "c1a",
   "name": "Video card",
   "settings": [
    {
     "type": "image_picker",
     "id": "i1",
     "label": "Image"
    },
    {
     "type": "text",
     "id": "t2",
     "label": "Built-in image (used when no image is pi"
    },
    {
     "type": "text",
     "id": "t3",
     "label": "Quote: \"It's making me pull dow..."
    },
    {
     "type": "text",
     "id": "t4",
     "label": "Name: Annie Kay, All-American"
    },
    {
     "type": "video",
     "id": "kg_video",
     "label": "Video (Shopify file)"
    },
    {
     "type": "url",
     "id": "kg_video_url",
     "label": "Video URL",
     "info": "Use a permanent Shopify-hosted file before changing the domain."
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "KITTED: Real ballplaye 2"
  }
 ]
}
{% endschema %}

<div class="kg">
<section class="section band--stone">
<div class="wrap split">
<div class="split__media" style="order:2"><div style="max-width:380px;margin-inline:auto"><figure class="vcard" style="margin:0">
<div class="vcard__frame">
{%- if section.settings.i1 != blank -%}{{ section.settings.i1 | image_url: width: 1800 | image_tag: alt: "", loading: "lazy", style: "position:absolute;inset:0;width:100%;height:100%;object-fit:cover" }}{%- else -%}<img src="{{ section.settings.t2 | asset_url }}" width="720" height="1280" alt="" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">{%- endif -%}
</div>
</figure></div></div>
<div class="split__text">
<p class="eyebrow">{{ section.settings.t3 }}</p>
<h2 class="h-section">{{ section.settings.t4 }}</h2>
<p class="lede">{{ section.settings.t5 }}</p>
<div class="btn-row"><a class="btn" href="#buy">{{ section.settings.t6 }}<svg aria-hidden="true" class="arrow" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></div>
</div>
</div>
</section>
</div>

{% schema %}
{
 "name": "KITTED: A softball dad sh",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "image_picker",
   "id": "i1",
   "label": "Image"
  },
  {
   "type": "text",
   "id": "t2",
   "label": "Built-in image (used when no image is pi",
   "default": "kg-poster-softball-call.webp"
  },
  {
   "type": "text",
   "id": "t3",
   "label": "Eyebrow: Listen to the call"
  },
  {
   "type": "text",
   "id": "t4",
   "label": "Heading: A softball dad shocked b..."
  },
  {
   "type": "text",
   "id": "t5",
   "label": "Text: If you're not using Spin..."
  },
  {
   "type": "text",
   "id": "t6",
   "label": "Link text: Shop SpinGrip"
  }
 ],
 "presets": [
  {
   "name": "KITTED: A softball dad sh"
  }
 ]
}
{% endschema %}

<div class="kg">
<section class="section band--ink">
<div class="wrap">
<div class="section-head section-head--row"><div><h2 class="h-section">{{ section.settings.t1 }}</h2><p class="lede muted">{{ section.settings.t2 }}</p></div><div class="carousel__nav"><button aria-label="Previous" class="carousel__btn" data-car="car-coaches" data-dir="-1" type="button"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"></path></svg></button><button aria-label="Next" class="carousel__btn" data-car="car-coaches" data-dir="1" type="button"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"></path></svg></button></div></div>
<div class="carousel" id="car-coaches"><div class="carousel__track">{%- for block in section.blocks -%}{%- case block.type -%}{%- when "c1a" -%}<figure {{ block.shopify_attributes }} class="vcard" style="margin:0">
<div class="vcard__frame">
{%- if block.settings.i1 != blank -%}{{ block.settings.i1 | image_url: width: 1800 | image_tag: alt: "", loading: "lazy", style: "position:absolute;inset:0;width:100%;height:100%;object-fit:cover" }}{%- else -%}<img src="{{ block.settings.t2 | asset_url }}" width="720" height="1280" alt="" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">{%- endif -%}
</div>
<div class="vcard__cap"><p class="vcard__quote">{{ block.settings.t3 }}</p><p class="vcard__who">{{ block.settings.t4 }}</p></div>
</figure>{%- endcase -%}{%- endfor -%}</div></div>
</div>
</section>
</div>

{% schema %}
{
 "name": "KITTED: Coaches & players",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "text",
   "id": "t1",
   "label": "Heading: Coaches & players love S…",
   "default": "Coaches & players love SpinGrip"
  },
  {
   "type": "text",
   "id": "t2",
   "label": "Text: Hear it directly from th…",
   "default": "Hear it directly from the athletes and coaches who use SpinGrip every day."
  }
 ],
 "blocks": [
  {
   "type": "c1a",
   "name": "Video card",
   "settings": [
    {
     "type": "image_picker",
     "id": "i1",
     "label": "Image"
    },
    {
     "type": "text",
     "id": "t2",
     "label": "Built-in image (used when no image is picked)"
    },
    {
     "type": "text",
     "id": "t3",
     "label": "Quote: “This will maximize your…"
    },
    {
     "type": "text",
     "id": "t4",
     "label": "Name: Jaymee Lynn · Pitching C…"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "KITTED: Coaches & players"
  }
 ]
}
{% endschema %}

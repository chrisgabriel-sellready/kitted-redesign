<div class="kg">
<section aria-label="2026 Throwing Product of the Year" class="award">
<div aria-hidden="true" class="award__confetti"></div>
<div class="wrap award__inner">
<figure class="award__media">{%- assign kg_alt = section.settings.t3 | escape -%}{%- if section.settings.i1 != blank -%}{{ section.settings.i1 | image_url: width: 1800 | image_tag: alt: kg_alt, loading: "lazy" }}{%- else -%}<img src="{{ section.settings.t2 | asset_url }}" alt="{{ section.settings.t3 | escape }}" width="640" height="640" loading="lazy">{%- endif -%}<span class="award__tag"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="9" r="6"></circle><path d="M8.5 13.8 7 22l5-3 5 3-1.5-8.2"></path></svg>{{ section.settings.t4 }}</span></figure>
<div class="award__text">
<span aria-label="5 out of 5 stars" class="award__stars" role="img"><svg aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"></path></svg><svg aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"></path></svg><svg aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"></path></svg><svg aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"></path></svg><svg aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"></path></svg></span>
<p class="award__eyebrow">{{ section.settings.t5 }}</p>
<h2 class="award__title">{{ section.settings.i6 }}</h2>
<p class="award__quote">{{ section.settings.t7 }}</p>
<p class="award__by">{{ section.settings.t8 }}</p>
<div class="award__btns"><button class="pill-btn pill-btn--dark" data-poster="{{ 'kg-chips-award-still.webp' | asset_url }}" data-vmodal="{{ section.settings.u9 }}" type="button"><svg aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M7 4l13 8-13 8z"></path></svg>{{ section.settings.t10 }}</button><a class="pill-btn" href="#buy">{{ section.settings.t11 }}</a></div>
</div>
</div>
</section>
</div>

{% schema %}
{
 "name": "KITTED: 2026 Throwing 2",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "image_picker",
   "id": "i1",
   "label": "Image"
  },
  {
   "type": "text",
   "id": "t2",
   "label": "Built-in image (used when no image is picked)",
   "default": "kg-chips-baseball-bottom-right.webp"
  },
  {
   "type": "text",
   "id": "t3",
   "label": "Image alt text",
   "default": "Chips Performance wearing SpinGrip Baseball"
  },
  {
   "type": "text",
   "id": "t4",
   "label": "Text: Awarded by Chips",
   "default": "Awarded by Chips"
  },
  {
   "type": "text",
   "id": "t5",
   "label": "Eyebrow: SpinGrip awarded",
   "default": "SpinGrip awarded"
  },
  {
   "type": "inline_richtext",
   "id": "i6",
   "label": "Heading: 2026 Throwing Product of…",
   "default": "2026 Throwing <em>Product</em> of the Year"
  },
  {
   "type": "text",
   "id": "t7",
   "label": "Quote: A must-have to get the m…",
   "default": "A must-have to get the most out of your throws."
  },
  {
   "type": "text",
   "id": "t8",
   "label": "Name: Chips Performance · Thro…",
   "default": "Chips Performance · Throwing coach & diamond sport expert"
  },
  {
   "type": "url",
   "id": "u9",
   "label": "Pop-up video URL"
  },
  {
   "type": "text",
   "id": "t10",
   "label": "Link text: Watch",
   "default": "Watch"
  },
  {
   "type": "text",
   "id": "t11",
   "label": "Link text: Shop SpinGrip",
   "default": "Shop SpinGrip"
  }
 ],
 "presets": [
  {
   "name": "KITTED: 2026 Throwing 2"
  }
 ]
}
{% endschema %}

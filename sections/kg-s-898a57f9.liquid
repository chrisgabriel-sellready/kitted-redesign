<div class="kg">
<section class="hero" aria-roledescription="carousel" aria-label="Featured SpinGrip gloves"><div class="hero__slides"><div class="hero__slide is-on" aria-roledescription="slide" aria-label="1 of 3">
  <picture><source media="(max-width: 640px)" srcset="{{ 'kg-baseball-hero-mobile-v3.webp' | asset_url }}"><img src="{{ 'kg-baseball-hero-desktop-v3.webp' | asset_url }}" alt="" width="1920" height="1080" fetchpriority="high"></picture>
  <p class="hero__credit hero__credit--l">Dylan Cheek<br>Arkansas Commit</p><p class="hero__credit hero__credit--r">Dax Price<br>2029 Top Texas Prospect</p>
  <div class="hero__content"><div class="wrap">
    <p class="eyebrow">Introducing the KITTED SpinGrip Baseball</p>
    <h1 class="display hero__title">Own the Diamond</h1>
    <p class="hero__body">Proven to increase velocity, spin rate, and accuracy.</p>
    <a class="btn btn--light" href="/pages/baseball">Shop Baseball<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
  </div></div>
</div><div class="hero__slide" aria-roledescription="slide" aria-label="2 of 3">
  <picture><source media="(max-width: 640px)" srcset="{{ 'kg-softball-hero-mobile.webp' | asset_url }}"><img src="{{ 'kg-softball-hero-desktop.webp' | asset_url }}" alt="" width="1920" height="1080" loading="lazy"></picture>
  <p class="hero__credit hero__credit--l">18U Team Mercado<br>Texas Select</p>
  <div class="hero__content"><div class="wrap">
    <p class="eyebrow">Introducing the KITTED SpinGrip Softball</p>
    <h2 class="display hero__title">The Time is Now</h2>
    <p class="hero__body">Tighter spins, stronger throws.</p>
    <a class="btn btn--light" href="/pages/softball">Shop Softball<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
  </div></div>
</div><div class="hero__slide" aria-roledescription="slide" aria-label="3 of 3">
  <picture><source media="(max-width: 640px)" srcset="{{ 'kg-pop-hero-mobile-v2.webp' | asset_url }}"><img src="{{ 'kg-pop-hero-desktop.webp' | asset_url }}" alt="" width="1920" height="1080" loading="lazy"></picture>
  <p class="hero__credit hero__credit--l">Peyton “Pop” Houston<br>Elite 11 Champ</p>
  <div class="hero__content"><div class="wrap">
    <p class="eyebrow">Introducing the KITTED SpinGrip Football</p>
    <h2 class="display hero__title">Calling All QB1s</h2>
    <p class="hero__body">The first and only QB throwing glove built to enhance spirals, velocity and accuracy.</p>
    <a class="btn btn--light" href="/pages/football">Shop Football<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
  </div></div>
</div></div><div class="hero__dots"><button class="hero__dot" type="button" aria-label="Show baseball slide" aria-current="true"></button><button class="hero__dot" type="button" aria-label="Show softball slide" aria-current="false"></button><button class="hero__dot" type="button" aria-label="Show football slide" aria-current="false"></button><button class="hero__pause" type="button" aria-label="Pause slideshow"></button></div></section>
</div>
{% schema %}
{"name": "KITTED: Own the Diamond", "tag": "div", "class": "kg-section", "settings": []}
{% endschema %}

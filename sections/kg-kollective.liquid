{% assign kg_full_page = section.settings.full_page %}
<div class="kg">
<section class="section {% if kg_full_page %}roster-page{% else %}band--ink roster-band{% endif %}" id="kollective" style="scroll-margin-top:calc(var(--header-h, 80px) + 8px)" data-jersey-scope aria-label="Early roster access">
  <div class="wrap">
    <div class="page-head center" style="justify-items:center;padding-top:0">
      <p class="roster-band__tag">{{ section.settings.tag }}</p>
      {% if kg_full_page %}<h1 class="page-title">{{ section.settings.heading }}</h1>{% else %}<h2 class="page-title">{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.subtitle != blank %}<p class="roster-page__subtitle">{{ section.settings.subtitle }}</p>{% endif %}
      <p class="lede muted">{{ section.settings.text }}</p>
      <span class="pill"><span class="dot" style="background:var(--green)"></span>{{ section.settings.badge }}</span>
    </div>
    <div class="kollective">
      <div class="jersey"><svg class="jersey-svg" viewBox="0 0 600 300" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" aria-label="KITTED jersey YOUR NAME number 00"><defs><pattern id="h-pin" width="11" height="11" patternUnits="userSpaceOnUse"><rect width="11" height="11" fill="#fbfaf5"></rect><rect x="5" width="1" height="11" fill="#14213d" opacity="0.6"></rect></pattern><linearGradient id="h-shade" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#000" stop-opacity="0.14"></stop><stop offset="0.25" stop-color="#000" stop-opacity="0"></stop><stop offset="0.75" stop-color="#000" stop-opacity="0"></stop><stop offset="1" stop-color="#000" stop-opacity="0.14"></stop></linearGradient><clipPath id="bodyclip"><path d="M108 26 Q150 50 192 26 L250 50 Q270 70 288 118 L246 140 L234 116 L236 284 Q150 292 64 284 L66 116 L54 140 L12 118 Q30 70 50 50 Z"></path></clipPath><path id="arch" d="M80 100 Q150 76 220 100"></path></defs><g><path d="M108 26 Q150 50 192 26 L250 50 Q270 70 288 118 L246 140 L234 116 L236 284 Q150 292 64 284 L66 116 L54 140 L12 118 Q30 70 50 50 Z" fill="url(#h-pin)"></path><g clip-path="url(#bodyclip)"><rect width="300" height="300" fill="url(#h-shade)"></rect><path d="M60 276 Q150 284 240 276" stroke="#14213d" stroke-width="5" fill="none"></path><rect x="146" y="64" width="8" height="220" fill="#14213d" opacity="0.12"></rect><line x1="150" y1="64" x2="150" y2="284" stroke="#14213d" stroke-width="1.5"></line><circle cx="150" cy="70" r="2.6" fill="#fff" stroke="#14213d" stroke-width="1"></circle><circle cx="150" cy="110" r="2.6" fill="#fff" stroke="#14213d" stroke-width="1"></circle><circle cx="150" cy="150" r="2.6" fill="#fff" stroke="#14213d" stroke-width="1"></circle><circle cx="150" cy="190" r="2.6" fill="#fff" stroke="#14213d" stroke-width="1"></circle><circle cx="150" cy="230" r="2.6" fill="#fff" stroke="#14213d" stroke-width="1"></circle><circle cx="150" cy="266" r="2.6" fill="#fff" stroke="#14213d" stroke-width="1"></circle></g><path d="M108 26 Q150 50 192 26 L250 50 Q270 70 288 118 L246 140 L234 116 L236 284 Q150 292 64 284 L66 116 L54 140 L12 118 Q30 70 50 50 Z" fill="none" stroke="#14213d" stroke-width="2.5" stroke-linejoin="round"></path><path d="M108 28 L150 60 L192 28" fill="none" stroke="#14213d" stroke-width="7" stroke-linejoin="round" stroke-linecap="round"></path><path d="M113 34 L150 63 L187 34" fill="none" stroke="#b31b2c" stroke-width="2" stroke-linejoin="round"></path><path d="M15 112 L57 132" stroke="#14213d" stroke-width="7"></path><path d="M18 106 L59 126" stroke="#b31b2c" stroke-width="2"></path><path d="M285 112 L243 132" stroke="#14213d" stroke-width="7"></path><path d="M282 106 L241 126" stroke="#b31b2c" stroke-width="2"></path><circle cx="96" cy="78" r="17" fill="#14213d" stroke="#b31b2c" stroke-width="2.5"></circle><circle cx="96" cy="78" r="13.5" fill="none" stroke="#fff" stroke-width="0.8" stroke-dasharray="1.6 1.6"></circle><text x="96" y="83" text-anchor="middle" fill="#fff" font-family="'Barlow Condensed', Impact, sans-serif" font-weight="900" font-size="13" letter-spacing="0.5">KG</text><image href="{{ 'kg-k-black.png' | asset_url }}" xlink:href="{{ 'kg-k-black.png' | asset_url }}" x="194" y="68" width="18" height="18" preserveAspectRatio="xMidYMid meet"></image><text x="150" y="138" text-anchor="middle" fill="#14213d" stroke="#b31b2c" stroke-width="2.5" paint-order="stroke" stroke-linejoin="round" font-family="'Barlow Condensed', Impact, sans-serif" font-weight="900" font-style="italic" font-size="44" letter-spacing="3" transform="rotate(-6 150 130)">KITTED</text><g font-family="'Barlow Condensed', Impact, sans-serif" font-weight="900" font-size="40" text-anchor="middle"><text x="196" y="196" fill="#14213d" stroke="#14213d" stroke-width="5" stroke-linejoin="round"><tspan data-j-num>00</tspan></text><text x="196" y="196" fill="#b31b2c"><tspan data-j-num>00</tspan></text></g></g><g transform="translate(300 0)"><path d="M108 26 Q150 50 192 26 L250 50 Q270 70 288 118 L246 140 L234 116 L236 284 Q150 292 64 284 L66 116 L54 140 L12 118 Q30 70 50 50 Z" fill="url(#h-pin)"></path><g clip-path="url(#bodyclip)"><rect width="300" height="300" fill="url(#h-shade)"></rect><path d="M100 150 Q110 210 96 280" stroke="#000" stroke-opacity="0.06" stroke-width="6" fill="none"></path><path d="M205 160 Q195 220 208 282" stroke="#000" stroke-opacity="0.06" stroke-width="6" fill="none"></path><path d="M60 276 Q150 284 240 276" stroke="#14213d" stroke-width="5" fill="none"></path></g><path d="M108 26 Q150 50 192 26 L250 50 Q270 70 288 118 L246 140 L234 116 L236 284 Q150 292 64 284 L66 116 L54 140 L12 118 Q30 70 50 50 Z" fill="none" stroke="#14213d" stroke-width="2.5" stroke-linejoin="round"></path><path d="M108 28 Q150 52 192 28" fill="none" stroke="#14213d" stroke-width="7" stroke-linejoin="round" stroke-linecap="round"></path><path d="M111 33 Q150 55 189 33" fill="none" stroke="#b31b2c" stroke-width="2" stroke-linejoin="round"></path><path d="M15 112 L57 132" stroke="#14213d" stroke-width="7"></path><path d="M18 106 L59 126" stroke="#b31b2c" stroke-width="2"></path><path d="M285 112 L243 132" stroke="#14213d" stroke-width="7"></path><path d="M282 106 L241 126" stroke="#b31b2c" stroke-width="2"></path><text fill="#14213d" font-family="'Barlow Condensed', Impact, sans-serif" font-weight="900" font-size="24" letter-spacing="2" text-anchor="middle"><textPath href="#arch" xlink:href="#arch" startOffset="50%" data-j-name>YOUR NAME</textPath></text><g font-family="'Barlow Condensed', Impact, sans-serif" font-weight="900" font-size="100" text-anchor="middle"><text x="150" y="200" fill="#14213d" stroke="#14213d" stroke-width="9" stroke-linejoin="round"><tspan data-j-num>00</tspan></text><text x="150" y="200" fill="#b31b2c"><tspan data-j-num>00</tspan></text></g></g></svg>{% unless kg_full_page %}<p class="muted center" style="font-size:12px;margin-top:10px">Your name and number print live as you type.</p>{% endunless %}</div>
      {%- form 'customer', class: 'stack', id: 'kg-kollective-form', data-jersey: '', style: 'gap:14px' -%}
        <input type="hidden" name="contact[tags]" value="kollective">
        <input type="hidden" name="contact[first_name]"><input type="hidden" name="contact[last_name]">
        {%- if form.posted_successfully? -%}
          <p class="form-msg is-ok" role="status">{{ section.settings.success }}</p>
        {%- elsif form.errors -%}
          <p class="form-msg is-warn" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <div class="form-grid">
          <div class="kg-field full"><label{% if kg_full_page %} class="visually-hidden"{% endif %} for="hr-name">First and last name</label><input id="hr-name" name="fullname" placeholder="First and Last Name" autocomplete="name" required></div>
          <div class="kg-field"><label{% if kg_full_page %} class="visually-hidden"{% endif %} for="hr-num">Jersey # (0–99)</label><input id="hr-num" name="number" inputmode="numeric" maxlength="2" placeholder="{% if kg_full_page %}Jersey # (0–99){% else %}00{% endif %}"></div>
          <div class="kg-field"><label{% if kg_full_page %} class="visually-hidden"{% endif %} for="hr-email">Email address</label><input id="hr-email" name="contact[email]" type="email" placeholder="Email address" autocomplete="email" required></div>
          <div class="kg-field {% if kg_full_page %}roster-page__phone{% else %}full{% endif %}"><label{% if kg_full_page %} class="visually-hidden"{% endif %} for="hr-phone">Mobile number</label><input id="hr-phone" name="contact[phone]" type="tel" placeholder="Mobile number" autocomplete="tel"></div>
        {% if kg_full_page %}<button class="btn roster-page__submit" type="submit">{{ section.settings.button }}</button>{% endif %}
        </div>
        <label class="consent"><input type="checkbox" name="contact[accepts_marketing]" value="true" checked><span>{{ section.settings.consent | remove: "<p>" | remove: "</p>" }}</span></label>
        {% unless kg_full_page %}<button class="btn btn--gold btn--lg btn--block" type="submit">{{ section.settings.button }}</button>{% endunless %}
      {%- endform -%}
    </div>
  </div>
</section>
</div>
<script>
  (function () {
    var f = document.getElementById('kg-kollective-form'); if (!f) return;
    f.addEventListener('submit', function () {
      var parts = (f.querySelector('[name=fullname]').value || '').trim().split(/\s+/);
      f.querySelector('[name="contact[first_name]"]').value = parts.shift() || '';
      f.querySelector('[name="contact[last_name]"]').value = parts.join(' ');
      var n = (f.querySelector('[name=number]').value || '').replace(/\D/g, '');
      f.querySelector('[name="contact[tags]"]').value = 'kollective' + (n ? ',jersey-' + n : '');
    });
  })();
</script>
{% schema %}
{
 "name": "KITTED Kollective sign-up",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {"type":"checkbox","id":"full_page","label":"Full-page roster layout","default":false},
  {"type":"text","id":"subtitle","label":"Subtitle"},
  {
   "type": "text",
   "id": "tag",
   "label": "Tag",
   "default": "Early roster access"
  },
  {
   "type": "text",
   "id": "heading",
   "label": "Heading",
   "default": "The KITTED Kollective"
  },
  {
   "type": "textarea",
   "id": "text",
   "label": "Text",
   "default": "Special things are coming. Join The KITTED Kollective to get first access to new KITTED drops before they go public."
  },
  {
   "type": "text",
   "id": "badge",
   "label": "Badge",
   "default": "10% off your first order"
  },
  {
   "type": "text",
   "id": "button",
   "label": "Button",
   "default": "Join the roster"
  },
  {
   "type": "text",
   "id": "success",
   "label": "Success message",
   "default": "You're on the roster. Watch your inbox for early access and your 10% code."
  },
  {
   "type": "richtext",
   "id": "consent",
   "label": "Consent text",
   "default": "<p>Yes, text me. By checking this box and providing my mobile number, I agree to receive recurring automated marketing text messages from KITTED at the number provided. Consent is not a condition of purchase. Message and data rates may apply. Reply STOP to opt out, HELP for help. See our Privacy Policy and Terms.</p>"
  }
 ],
 "presets": [
  {
   "name": "KITTED Kollective sign-up"
  }
 ]
}
{% endschema %}

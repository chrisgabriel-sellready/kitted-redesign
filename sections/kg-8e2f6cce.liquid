<div class="kg">
<section class="section band--stone">
<div class="wrap">
<div class="section-head"><h2 class="h-section">{{ section.settings.t1 }}</h2><p class="lede muted">{{ section.settings.t2 }}</p></div>
<div class="grid grid--2">{%- for block in section.blocks -%}{%- case block.type -%}{%- when "c1a" -%}<figure {{ block.shopify_attributes }} class="frame frame--ink" style="margin:0">{%- assign kg_alt = block.settings.t3 | escape -%}{%- if block.settings.i1 != blank -%}{{ block.settings.i1 | image_url: width: 1800 | image_tag: alt: kg_alt, loading: "lazy", style: "aspect-ratio:1600/1275;object-fit:cover" }}{%- else -%}<img src="{{ block.settings.t2 | asset_url }}" alt="{{ block.settings.t3 | escape }}" width="1000" height="1200" loading="lazy" style="aspect-ratio:1600/1275;object-fit:cover">{%- endif -%}</figure>{%- endcase -%}{%- endfor -%}</div>
</div>
</section>
</div>

{% schema %}
{
 "name": "KITTED: Grip it like the",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "text",
   "id": "t1",
   "label": "Heading: Grip it like the pros"
  },
  {
   "type": "textarea",
   "id": "t2",
   "label": "Text: A clean index-finger fin..."
  }
 ],
 "blocks": [
  {
   "type": "c1a",
   "name": "Card",
   "settings": [
    {
     "type": "image_picker",
     "id": "i1",
     "label": "Image"
    },
    {
     "type": "text",
     "id": "t2",
     "label": "Built-in image (used when no image is pi"
    },
    {
     "type": "text",
     "id": "t3",
     "label": "Image alt text"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "KITTED: Grip it like the"
  }
 ]
}
{% endschema %}

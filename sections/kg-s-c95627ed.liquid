<div class="kg">
<section class="band--ink" style="padding-top:clamp(56px,7vw,96px)">
  <div class="wrap play">
    <div class="play__text">
      <p class="eyebrow" style="color:var(--gold)">Make a play</p>
      <h2 class="display" style="font-size:clamp(52px,6.6vw,96px)">There's never been a throwing tool like it.</h2>
      <div class="stats" style="--cols:3;width:100%">
        <div class="stat"><span class="stat__num">+7</span><span class="stat__label">MPH</span></div>
        <div class="stat"><span class="stat__num">+350</span><span class="stat__label">RPM</span></div>
        <div class="stat"><span class="stat__num">+30%</span><span class="stat__label">Accuracy</span></div>
      </div>
      <div class="btn-row"><a class="btn btn--light" href="/collections/all">Shop SpinGrip<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
      <p class="play__credit">BJ Brannon · USC commit</p>
    </div>
    <div class="play__media"><img src="{{ 'kg-make-a-play-usc-cutout.webp' | asset_url }}" alt="BJ Brannon, USC commit, wearing SpinGrip" width="829" height="1089" loading="lazy"><img src="{{ 'kg-spingrip-white.png' | asset_url }}" alt="SpinGrip" width="1200" height="138" loading="lazy" style="position:absolute;z-index:2;bottom:28px;width:min(420px,86%)"></div>
  </div>
</section>
</div>

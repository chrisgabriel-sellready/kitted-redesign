<div class="kg">
<section class="section">
<div class="wrap">
<div class="section-head section-head--row"><div><h2 class="h-section">{{ section.settings.t1 }}</h2><p class="lede muted">{{ section.settings.t2 }}</p></div><div class="carousel__nav"><button aria-label="Previous" class="carousel__btn" data-car="car-ugc" data-dir="-1" type="button"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"></path></svg></button><button aria-label="Next" class="carousel__btn" data-car="car-ugc" data-dir="1" type="button"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"></path></svg></button></div></div>
<div class="carousel" id="car-ugc"><div class="carousel__track">{%- for block in section.blocks -%}{%- case block.type -%}{%- when "c1a" -%}<figure {{ block.shopify_attributes }} class="vcard" style="margin:0">
<div class="vcard__frame">
{%- if block.settings.i1 != blank -%}{{ block.settings.i1 | image_url: width: 1800 | image_tag: alt: "", loading: "lazy", style: "position:absolute;inset:0;width:100%;height:100%;object-fit:cover" }}{%- else -%}<img src="{{ block.settings.t2 | asset_url }}" width="720" height="1280" alt="" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">{%- endif -%}
</div>
<div class="vcard__cap"><p class="vcard__quote">{{ block.settings.t3 }}</p><p class="vcard__who">{{ block.settings.t4 }}</p></div>
</figure>{%- when "c1b" -%}<figure {{ block.shopify_attributes }} class="vcard" data-video="" style="margin:0">
<div class="vcard__frame">
<video playsinline="" poster="{%- if block.settings.i3 != blank -%}{{ block.settings.i3 | image_url: width: 1200 }}{%- elsif block.settings.t4 != blank -%}{{ block.settings.t4 | asset_url }}{%- elsif block.settings.v1 != blank -%}{{ block.settings.v1.preview_image | image_url: width: 1200 }}{%- endif -%}" preload="none" src="{%- if block.settings.v1 != blank -%}{{ block.settings.v1.sources | where: "mime_type", "video/mp4" | map: "url" | first }}{%- else -%}{{ block.settings.u2 }}{%- endif -%}"></video>
<button aria-label="Play video: Cody Freeman, Big Leaguer" class="vcard__play" type="button"><span><svg aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M7 4l13 8-13 8z"></path></svg></span></button>
<button aria-label="Toggle sound" class="vcard__sound" type="button"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 5L6 9H2v6h4l5 4V5z"></path><path d="M23 9l-6 6M17 9l6 6"></path></svg>{{ block.settings.t5 }}</button>
</div>
<div class="vcard__cap"><p class="vcard__quote">{{ block.settings.t6 }}</p><p class="vcard__who">{{ block.settings.t7 }}</p></div>
</figure>{%- endcase -%}{%- endfor -%}</div></div>
</div>
</section>
</div>


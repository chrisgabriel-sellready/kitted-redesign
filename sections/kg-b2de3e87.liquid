<div class="kg">
<section class="shero">
<div class="shero__text">
<p class="eyebrow" style="color:var(--gold)">{{ section.settings.t1 }}</p>
<h1 class="display shero__title">{{ section.settings.h2 }}</h1>
<p class="shero__sub">{{ section.settings.t3 }}</p>
<div class="btn-row"><a class="btn btn--light" href="{{ section.settings.kg_shop_url | default: '#buy' }}">{{ section.settings.t4 }}<svg aria-hidden="true" class="arrow" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a><a class="btn btn--ghost-light" href="#how">{{ section.settings.t5 }}</a></div>
</div>
<div class="shero__media">
{% assign kg_football_wide = section.settings.desktop_url %}
{% assign kg_football_tall = section.settings.mobile_url | default: kg_football_wide %}
{% render 'kg-hero-video', desktop_video: section.settings.desktop_video, desktop_url: kg_football_wide, mobile_video: section.settings.mobile_video, mobile_url: kg_football_tall, desktop_image: section.settings.i6, desktop_asset: section.settings.t7, mobile_image: section.settings.i8, mobile_asset: section.settings.t9 %}
{%- assign kg_alt = section.settings.t12 | escape -%}{%- if section.settings.i10 != blank -%}{{ section.settings.i10 | image_url: width: 1800 | image_tag: alt: kg_alt, class: "shero__seal", loading: "lazy" }}{%- else -%}<img src="{{ section.settings.t11 | asset_url }}" class="shero__seal" alt="{{ section.settings.t12 | escape }}" width="96" height="94" loading="lazy">{%- endif -%}
</div>
</section>
</div>

{% schema %}
{
 "name": "KITTED: Tighter spirals.",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "text",
   "id": "t1",
   "label": "Eyebrow: SpinGrip Football"
  },
  {
   "type": "html",
   "id": "h2",
   "label": "Heading: Tighter spirals. Precisi..."
  },
  {
   "type": "textarea",
   "id": "t3",
   "label": "Text: Introducing SpinGrip Foo..."
  },
  {
   "type": "text",
   "id": "t4",
   "label": "Link text: Shop SpinGrip"
  },
  {
   "type": "text",
   "id": "t5",
   "label": "Link text: How it works"
  },
  {
   "type": "image_picker",
   "id": "i6",
   "label": "Image"
  },
  {
   "type": "text",
   "id": "t7",
   "label": "Built-in image (used when no image is pi",
   "default": "kg-football-hero-wide-poster.webp"
  },
  {
   "type": "image_picker",
   "id": "i8",
   "label": "Image"
  },
  {
   "type": "text",
   "id": "t9",
   "label": "Built-in image (used when no image is pi",
   "default": "kg-football-hero-tall-poster.webp"
  },
  {
   "type": "image_picker",
   "id": "i10",
   "label": "Image"
  },
  {
   "type": "text",
   "id": "t11",
   "label": "Built-in image (used when no image is pi",
   "default": "kg-patent-seal-green.webp"
  },
  {
   "type": "text",
   "id": "t12",
   "label": "Image alt text"
  },
  {
   "type": "video",
   "id": "desktop_video",
   "label": "Desktop hero video"
  },
  {
   "type": "url",
   "id": "desktop_url",
   "label": "Desktop video URL"
  },
  {
   "type": "video",
   "id": "mobile_video",
   "label": "Mobile hero video"
  },
  {
   "type": "url",
   "id": "mobile_url",
   "label": "Mobile video URL"
  },
  {
   "type": "url",
   "id": "kg_shop_url",
   "label": "Shop button link",
   "info": "Leave empty to scroll to the buy box on this page."
  }
 ],
 "presets": [
  {
   "name": "KITTED: Tighter spirals."
  }
 ]
}
{% endschema %}

{%- liquid
  assign footer_light = true
  if template.name == 'index' and template.suffix == blank
    assign footer_light = false
  endif
-%}
<div class="kg">
<footer class="site-footer site-footer--current{% if footer_light %} site-footer--light{% endif %}">
  <div class="wrap footer__stack">
    <img class="footer__logo" src="{% if footer_light %}{{ 'kg-kitted-logo-black.png' | asset_url }}{% else %}{{ 'kg-kitted-logo-white.png' | asset_url }}{% endif %}" alt="SpinGrip by KITTED" width="49" height="43" loading="lazy">
    <p class="footer__tagline">{{ section.settings.tagline }}</p>
    <nav class="footer__sports" aria-label="Sports"><a href="/pages/baseball">Baseball</a><a href="/pages/softball">Softball</a><a href="/pages/football">Football</a></nav>
    {%- if section.settings.show_social -%}<div class="footer__social"><a href="{{ settings.social_instagram_link | default: 'https://www.instagram.com/kittedspingrip' }}" aria-label="Instagram" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><path d="M17.5 6.5h.01"/></svg></a><a href="{{ settings.social_tiktok_link | default: 'https://www.tiktok.com/@kittedgear' }}" aria-label="TikTok" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.6 6.7a4.8 4.8 0 01-3.8-4.3V2h-3.4v13.7a2.9 2.9 0 01-5.2 1.7 2.9 2.9 0 012.3-4.6c.3 0 .6 0 .9.1V9.4h-1a6.3 6.3 0 00-4.6 10.7 6.3 6.3 0 0010.9-4.4V8.7a8.2 8.2 0 004.7 1.5V6.8a4.8 4.8 0 01-1.8-.1z"/></svg></a><a href="{{ settings.social_youtube_link | default: 'https://www.youtube.com/@KittedGear' }}" aria-label="YouTube" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 17a24.12 24.12 0 010-10 2 2 0 011.4-1.4 49.56 49.56 0 0116.2 0A2 2 0 0121.5 7a24.12 24.12 0 010 10 2 2 0 01-1.4 1.4 49.55 49.55 0 01-16.2 0A2 2 0 012.5 17z"/><path d="m10 15 5-3-5-3z"/></svg></a></div>{%- endif -%}
    <nav class="footer__policies" aria-label="Footer">
      {%- if section.settings.menu.links.size > 0 -%}
        {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      {%- else -%}<a href="/pages/how-to-use-spingrip">The SpinGrip Effect</a><a href="/pages/contact">Contact</a><a href="/policies/privacy-policy">Privacy</a><a href="/policies/terms-of-service">Terms</a><a href="/pages/returns">Returns</a>{%- endif -%}
    </nav>
    <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
  </div>
</footer>
</div>
{% schema %}
{
 "name": "KITTED footer",
 "tag": "div",
 "class": "kg-section",
 "enabled_on": {
  "groups": [
   "footer"
  ]
 },
 "settings": [
  {
   "type": "link_list",
   "id": "menu",
   "label": "Footer menu",
   "info": "Leave empty to use the live-site support and policy links."
  },
  {
   "type": "checkbox",
   "id": "show_social",
   "label": "Show social icons",
   "default": true
  },
  {
   "type": "paragraph",
   "content": "Social links come from Theme settings \u2192 Social media."
  },
  {
   "type": "text",
   "id": "tagline",
   "label": "Tagline",
   "default": "Made by athletes, for athletes. Become One of Them."
  }
 ]
}
{% endschema %}

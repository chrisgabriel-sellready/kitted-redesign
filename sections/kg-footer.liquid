<div class="kg">
<footer class="site-footer{% if template.suffix == 'kollective' %} site-footer--roster{% endif %}">
  <div class="wrap">
    <nav class="footer__links" aria-label="Footer">
      {%- if section.settings.menu.links.size > 0 -%}
        {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      {%- else -%}<a href="/products/spingrip">Baseball</a><a href="/pages/spingrip-softball-is-here">Softball</a><a href="/products/spin-grip-football?view=football">Football</a><a href="/pages/team-orders">Bulk orders</a><a href="/pages/how-to-use-spingrip">The SpinGrip Effect</a><a href="/?view=kollective">The Kollective</a><a href="/pages/contact">Contact</a><a href="/pages/returns">Returns</a><a href="/policies/privacy-policy">Privacy</a><a href="/policies/terms-of-service">Terms</a>{%- endif -%}
    </nav>
    {%- if section.settings.show_social -%}<div class="footer__social"><a href="{{ settings.social_instagram_link | default: 'https://www.instagram.com/kittedspingrip' }}" aria-label="KITTED on Instagram" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a><a href="{{ settings.social_tiktok_link | default: 'https://www.tiktok.com/@kittedgear' }}" aria-label="KITTED on TikTok" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.6 6.7a4.8 4.8 0 01-3.8-4.3V2h-3.4v13.7a2.9 2.9 0 01-5.2 1.7 2.9 2.9 0 012.3-4.6c.3 0 .6 0 .9.1V9.4h-1a6.3 6.3 0 00-4.6 10.7 6.3 6.3 0 0010.9-4.4V8.7a8.2 8.2 0 004.7 1.5V6.8a4.8 4.8 0 01-1.8-.1z"/></svg></a><a href="{{ settings.social_youtube_link | default: 'https://www.youtube.com/@KittedGear' }}" aria-label="KITTED on YouTube" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7.2a3 3 0 00-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 001 7.2 31 31 0 00.5 12 31 31 0 001 16.8a3 3 0 002.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 002.1-2.1 31 31 0 00.5-4.8 31 31 0 00-.5-4.8zM9.7 15V9l5.8 3z"/></svg></a><a href="{{ settings.social_facebook_link | default: 'https://www.facebook.com/profile.php?id=61575828466725' }}" aria-label="KITTED on Facebook" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8.5V6.7c0-.8.5-1.2 1.2-1.2H17V2.2h-2.6C11.6 2.2 10.6 4 10.6 6.4v2.1H8v3.3h2.6V22H14V11.8h2.6l.4-3.3z"/></svg></a></div>{%- endif -%}
    <div class="footer__base">
      <img src="{% if template.suffix == 'kollective' %}{{ 'kg-kitted-logo-black.png' | asset_url }}{% else %}{{ 'kg-kitted-logo-white.png' | asset_url }}{% endif %}" alt="KITTED" width="47" height="40" loading="lazy">
      <p>{{ section.settings.tagline }}</p>
      <p class="footer__trust"><span>Secure checkout</span><span>Ships from the USA</span><span>Patent pending</span><span>30-day guarantee</span></p>
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    </div>
  </div>
</footer>
</div>
{% schema %}
{
 "name": "KITTED footer",
 "tag": "div",
 "class": "kg-section",
 "enabled_on": {
  "groups": [
   "footer"
  ]
 },
 "settings": [
  {
   "type": "link_list",
   "id": "menu",
   "label": "Footer menu",
   "info": "Leave empty to use the default KITTED links."
  },
  {
   "type": "checkbox",
   "id": "show_social",
   "label": "Show social icons",
   "default": true
  },
  {
   "type": "paragraph",
   "content": "Social links come from Theme settings \u2192 Social media."
  },
  {
   "type": "text",
   "id": "tagline",
   "label": "Tagline",
   "default": "Made by athletes, for athletes. Become One of Them."
  }
 ]
}
{% endschema %}

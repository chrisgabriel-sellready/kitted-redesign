<div class="split__media" style=""><div style="max-width:380px;margin-inline:auto"><figure class="vcard" data-video="" style="margin:0">
<div class="vcard__frame">{% render 'kg-video-card-media', video: section.settings.kg_video, url: section.settings.kg_video_url, image: section.settings.i1, poster: section.settings.t2 %}</div>
</figure></div></div>
<div class="split__text">

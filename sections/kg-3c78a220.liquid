<div class="kg">
<section class="section">
<div class="wrap split split--media-first">
<div class="split__media" style=""><div style="max-width:380px;margin-inline:auto"><figure class="vcard" style="margin:0">
<div class="vcard__frame">
{%- if section.settings.i1 != blank -%}{{ section.settings.i1 | image_url: width: 1800 | image_tag: alt: "", loading: "lazy", style: "position:absolute;inset:0;width:100%;height:100%;object-fit:cover" }}{%- else -%}<img src="{{ section.settings.t2 | asset_url }}" width="720" height="1280" alt="" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">{%- endif -%}
</div>
</figure></div></div>
<div class="split__text">
<p class="eyebrow">{{ section.settings.t3 }}</p>
<h2 class="h-section">{{ section.settings.t4 }}</h2>
<p class="lede">{{ section.settings.t5 }}</p>
<blockquote style="margin:0;display:grid;gap:8px"><p class="vcard__quote" style="font-size:18px">{{ section.settings.t6 }}</p><p class="vcard__who">{{ section.settings.t7 }}</p></blockquote>
<div class="btn-row"><a class="btn" href="#buy">{{ section.settings.t8 }}<svg aria-hidden="true" class="arrow" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></div>
</div>
</div>
</section>
</div>

{% schema %}
{
 "name": "KITTED: Peyton “Pop” Hous",
 "tag": "div",
 "class": "kg-section",
 "settings": [
  {
   "type": "image_picker",
   "id": "i1",
   "label": "Image"
  },
  {
   "type": "text",
   "id": "t2",
   "label": "Built-in image (used when no image is picked)",
   "default": "kg-poster-football-ugc-1.webp"
  },
  {
   "type": "text",
   "id": "t3",
   "label": "Eyebrow: Must watch",
   "default": "Must watch"
  },
  {
   "type": "text",
   "id": "t4",
   "label": "Heading: Peyton “Pop” Houston usi…",
   "default": "Peyton “Pop” Houston using SpinGrip Football"
  },
  {
   "type": "text",
   "id": "t5",
   "label": "Text: Elite 11 champ Peyton “P…",
   "default": "Elite 11 champ Peyton “Pop” Houston puts SpinGrip Football to work."
  },
  {
   "type": "text",
   "id": "t6",
   "label": "Quote: “Now it just feels like …",
   "default": "“Now it just feels like a Nerf ball.”"
  },
  {
   "type": "text",
   "id": "t7",
   "label": "Name: Peyton “Pop” Houston",
   "default": "Peyton “Pop” Houston"
  },
  {
   "type": "text",
   "id": "t8",
   "label": "Link text: Shop SpinGrip",
   "default": "Shop SpinGrip"
  }
 ],
 "presets": [
  {
   "name": "KITTED: Peyton “Pop” Hous"
  }
 ]
}
{% endschema %}

{%- comment -%} Alternate product template suffix for a KITTED product handle (blank = default template). Params: p (product) {%- endcomment -%}
{%- liquid
  assign kg_view = ''
  case p.handle
    when 'spingrip-softball'
      assign kg_view = 'softball'
    when 'spingrip-softball-pitcher'
      assign kg_view = 'softball-pitcher'
    when 'spin-grip-football'
      assign kg_view = 'football'
    when 'spingrips-exclusive-throwing-blueprint'
      assign kg_view = 'formula-baseball'
    when 'spingrip-softballs-d-1-throwing-formula-150-value-instant-digital-access'
      assign kg_view = 'formula-softball'
    when 'spingrip-footballs-d-1-throwing-formula-150-value-instant-digital-access'
      assign kg_view = 'formula-football'
  endcase
-%}
{{- kg_view -}}

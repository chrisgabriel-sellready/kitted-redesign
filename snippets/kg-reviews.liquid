{% doc %}
  Render the installed Judge.me review widget for the supplied product.
  @param {product} p - Product whose reviews are shown.
{% enddoc %}
{%- if p != blank -%}
  <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ p.title | escape }}" data-id="{{ p.id }}" data-product-id="{{ p.id }}" data-widget="review" data-auto-install="false" data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}" data-entry-point="review_widget.js" data-entry-key="review-widget/main.js">
    {%- if p.metafields.judgeme.widget.size > 20 -%}<div class="jdgm-legacy-widget-content" style="display:none">{{ p.metafields.judgeme.widget }}</div>{%- endif -%}
  </div>
  {%- if p.metafields.judgeme.review_widget_data -%}
    <script>window.jdgm = window.jdgm || {}; jdgm.data = jdgm.data || {}; jdgm.data.reviewWidget = jdgm.data.reviewWidget || {}; jdgm.data.reviewWidget[{{ p.id }}] = {{ p.metafields.judgeme.review_widget_data }};</script>
  {%- endif -%}
{%- endif -%}
